# ---- Nebius Token Factory (Nemotron models) ----
# Get your API key from the Nebius Token Factory / Nebius AI Studio console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional public web search. TAVILY_API_KEY is also accepted.
TAVIL_API_KEY=

# Confirmed against the live Token Factory model catalog
# (https://tokenfactory.nebius.com/model-catalog.md).
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Hard daily spend cap in USD. Calls are blocked once the day's logged cost exceeds this.
DAILY_SPEND_CAP_USD=5.0

# Temporary local debugging only: model output may contain private email data.
# Honored only when APP_ENV=development. Turn off after diagnosing.
GMAIL_NANO_DEBUG_OUTPUT=false

# ---- Security ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# ---- Database ----
DATABASE_URL=sqlite:///./persona_vault.db

# ---- OAuth: Google (Gmail + Calendar) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/oauth/callback/gmail
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/oauth/callback/gcal

# ---- OAuth: Spotify ----
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8000/api/oauth/callback/spotify

# ---- OAuth: Strava ----
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/api/oauth/callback/strava

# ---- OAuth: Trakt ----
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=
TRAKT_REDIRECT_URI=http://localhost:8000/api/oauth/callback/trakt

# ---- MCP server ----
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8800

# ---- App ----
APP_ENV=development
PUBLIC_DEMO=false
FRONTEND_URL=http://localhost:5173
DEMO_USER_EMAIL=demo@personavault.local